{
  "name": "sasu-cli",
  "version": "0.5.0",
  "private": true,
  "description": "sasu harness CLI: judge gates, verification runner, and absorbed implement state library",
  "type": "commonjs",
  "bin": {
    "sasu": "dist/cli.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --test \"test/unit/*.test.mjs\"",
    "test:e2e": "node --test \"test/e2e/*.test.mjs\"",
    "test:smoke": "node --test \"test/smoke/*.test.mjs\""
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.6.0"
  }
}
